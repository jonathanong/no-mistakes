      "integration": [],
      "queues": [],
      "react": [],
      "rules": [
        {
          "file": "src/query.ts",
          "line": 3,
          "message": "src/query.ts:3: WHERE filters orders.created_at, which is generated from uuid_extract_timestamp(id); consider using id directly with a bound or ordering that preserves the generation expression's semantics and uses an appropriate index",
          "rule": "postgres-generated-column-predicates",
          "target": "created_at"
        }
      ],
      "warnings": []
    }
  },
