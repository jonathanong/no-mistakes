      "react": [],
      "rules": [
        {
          "file": "src/query.ts",
          "line": 3,
          "message": "src/query.ts:3: INSERT must include ON CONFLICT or a conjunctive WHERE NOT EXISTS",
          "rule": "postgres-idempotent-insert",
          "target": "insert"
        }
      ],
      "warnings": []
