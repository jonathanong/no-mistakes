      "react": [],
      "rules": [
        {
          "file": "src/query.ts",
          "line": 3,
          "message": "ON CONFLICT target does not resolve to one valid, ready btree unique index in schemaCatalogPath",
          "rule": "postgres-conflict-ordering",
          "target": "unresolved-arbiter"
        }
      ],
      "warnings": []
    }
  },
