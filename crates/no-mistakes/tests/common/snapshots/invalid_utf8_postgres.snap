      "react": [],
      "rules": [
        {
          "file": "src/query.ts",
          "line": 3,
          "message": "src/query.ts:3: SELECT can return every row of orders; add a LIMIT, look rows up by a primary or unique key, or allow the table with a reason",
          "rule": "postgres-bounded-statements",
          "target": "table:orders"
        }
      ],
      "warnings": []
    }
  },
