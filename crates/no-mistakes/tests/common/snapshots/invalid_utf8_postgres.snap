      "rules": [
        {
          "file": "src/query.ts",
          "line": 3,
          "message": "src/query.ts:3: SELECT * reads all columns of orders, which is configured in relations; list the columns the caller uses",
          "rule": "postgres-explicit-columns",
          "target": "orders"
        }
      ],
      "warnings": []
    }
  },
  "postgres_generated_column_predicates": {
    "exitCode": 1,
    "report": {
      "advisories": [],
