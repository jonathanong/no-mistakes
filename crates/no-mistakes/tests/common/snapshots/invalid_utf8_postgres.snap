      "rules": [
        {
          "file": "src/query.ts",
          "import": "items.created_at",
          "line": 3,
          "message": "src/query.ts:3: do not write generated column `items.created_at`; PostgreSQL computes GENERATED ALWAYS columns — omit it from INSERT/UPDATE and write the source column instead",
          "rule": "postgres-no-generated-column-writes",
          "target": "created_at"
        }
      ],
      "warnings": []
    }
  },
