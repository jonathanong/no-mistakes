  },
  "postgres_lock_ordering": {
    "exitCode": 1,
    "report": {
      "advisories": [],
      "codebase": [],
      "integration": [],
      "queues": [],
      "react": [],
      "rules": [
        {
          "file": "src/query.ts",
          "line": 3,
          "message": "src/query.ts:3: multi-row FOR UPDATE without ORDER BY or SKIP LOCKED can deadlock (ABBA); add ORDER BY, use SKIP LOCKED, or add a `deadlock-safe` comment",
          "rule": "postgres-lock-ordering",
          "target": "lock-ordering"
        }
      ],
      "warnings": []
    }
  },
  "postgres_lock_written_rows_only": {
    "exitCode": 1,
    "report": {
      "advisories": [],
      "codebase": [],
