      "react": [],
      "rules": [
        {
          "file": "src/query.ts",
          "line": 3,
          "message": "src/query.ts:3: table-lock: LOCK TABLE widens contention; lock only the row being written",
          "rule": "postgres-lock-written-rows-only",
          "target": "table-lock"
        }
      ],
      "warnings": []
    }
