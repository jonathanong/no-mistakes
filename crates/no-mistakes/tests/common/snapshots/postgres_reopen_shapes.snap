      "rules": [
        {
          "file": "src/insert.ts",
          "line": 11,
          "message": "multi-row ON CONFLICT must order its INSERT source by catalog arbiter r.user_id ASC NULLS LAST",
          "rule": "postgres-conflict-ordering",
          "sourceLine": "return query(SQL`WITH requested AS (SELECT u.user_id, u.role FROM unnest(${userIds}::uuid[], ${roles}::text[]) AS u(user_id, role)), existing AS (SELECT p.user_id FROM participants p WHERE p.conversation_id = ${conversationId} ORDER BY p.user_id LIMIT ${HARD_MAX}) INSERT INTO participants (conversation_id, user_id, role) SELECT ${conversationId}, r.user_id, r.role FROM requested r ON CONFLICT (conversation_id, user_id) DO NOTHING`);",
          "target": "missing-canonical-order"
        },
        {
          "file": "src/root-cause.ts",
          "line": 11,
          "message": "multi-row ON CONFLICT DO NOTHING needs an explicit conflict target; targetless DO NOTHING can arbitrate different unique or exclusion constraints",
          "rule": "postgres-conflict-ordering",
          "sourceLine": "return query(SQL`WITH input AS (SELECT * FROM unnest(${userIds}::uuid[], ${roles}::text[]) AS incoming(user_id, role)), census AS (SELECT count(*)::int AS total FROM (SELECT 1 FROM participants WHERE conversation_id = ${cid} LIMIT ${HARD_MAX}) capped), free_slots AS (SELECT slot FROM generate_series(1, ${HARD_MAX}) AS slot), inserted AS (INSERT INTO participants (conversation_id, user_id, role) SELECT ${cid}, i.user_id, i.role FROM input i ON CONFLICT DO NOTHING RETURNING user_id) SELECT count(*) FROM inserted`);",
          "target": "targetless-arbiter"
        }
      ],
