#!/usr/bin/env node
const fs = require("node:fs");
const path = require("node:path");

if (process.argv.includes("--version")) {
  console.log("cargo fixture-version");
  process.exit(0);
}
const profile = process.env.RUNNER_OS === "macOS" ? [
  "--config", "profile.dev.package.no-mistakes.codegen-units=64",
  "--config", "profile.test.package.no-mistakes.codegen-units=64",
] : [];
if (JSON.stringify(process.argv.slice(2)) !== JSON.stringify([
  "build", ...profile, "--locked", "-p", "no-mistakes", "--timings", "--verbose", "--message-format=json-render-diagnostics",
])) {
  console.error("unexpected cargo arguments");
  process.exit(99);
}
const timings = path.join(process.env.CARGO_TARGET_DIR, "cargo-timings");
fs.mkdirSync(timings, { recursive: true });
fs.copyFileSync("timing.html", path.join(timings, "cargo-timing.html"));
console.log("fixture compiler stdout");
console.error("fixture compiler stderr");
if (process.env.NATIVE_BUILD_FIXTURE === "signal") process.kill(process.pid, "SIGKILL");
if (process.env.NATIVE_BUILD_FIXTURE === "exit-137") process.exit(137);
if (process.env.NATIVE_BUILD_FIXTURE === "prolific-cancel") {
  require("../backpressure/prolific-writer.cjs");
  setTimeout(() => process.exit(99), 12000);
  setInterval(() => {}, 1000);
} else if (process.env.NATIVE_BUILD_FIXTURE === "cancel") {
  console.log("fixture-ready");
  setInterval(() => {}, 1000);
} else if (process.env.NATIVE_BUILD_FIXTURE === "interleaved") {
  const artifact = fs.readFileSync("compiler-artifact.json", "utf8").trim();
  const middle = Math.floor(artifact.length / 2);
  process.stdout.write(artifact.slice(0, middle), () => {
    setTimeout(() => process.stderr.write("fixture interleaved compiler stderr\n", () => {
      setTimeout(() => process.stdout.write(`${artifact.slice(middle)}\n`, () => process.exit(0)), 10);
    }), 10);
  });
} else {
  console.log(fs.readFileSync("compiler-artifact.json", "utf8").trim());
  process.exit(process.env.NATIVE_BUILD_FIXTURE === "failure" ? 17 : 0);
}
