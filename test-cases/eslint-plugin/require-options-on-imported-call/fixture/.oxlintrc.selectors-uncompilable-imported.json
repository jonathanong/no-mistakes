{
  "jsPlugins": [
    {
      "name": "no-mistakes",
      "specifier": "../../../../packages/eslint-plugin-no-mistakes/src/index.js"
    }
  ],
  "rules": {
    "no-mistakes/require-options-on-imported-call": [
      "error",
      {
        "targets": [
          {
            "sourceSpecifierPatterns": ["agent"],
            "calleeNamePatterns": ["/(/"],
            "optionsPosition": 1,
            "requiredProperties": ["signal"]
          }
        ]
      }
    ]
  }
}
