{
  "categories": {
    "correctness": "off"
  },
  "jsPlugins": [
    {
      "name": "no-mistakes",
      "specifier": "../peers/after/src/index.js"
    }
  ],
  "rules": {
    "no-mistakes/async-call-disposition": [
      "error",
      {
        "targets": [
          {
            "sourceSpecifierPatterns": [
              "@bench/jobs"
            ],
            "calleeNamePatterns": [
              "enqueue"
            ]
          }
        ]
      }
    ],
    "typescript/no-floating-promises": "error"
  }
}
