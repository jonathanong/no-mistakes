rules:
  - rule: forbidden-calls
    scope: repository
    options:
      roots: [{ file: src/entry.ts }]
      invocations: [call, construct]
      targets:
        - function: { file: src/local.ts, symbol: localDanger }
        - function: { file: packages/lib/index.ts, symbol: danger }
        - function: { file: packages/lib/index.ts, symbol: Boom }
        - moduleExport: { module: "@fixture/lib", export: danger }
