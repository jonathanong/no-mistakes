export function safe(base: any, execute: (value: any) => unknown) {
  base.append(' WHERE active')
  return execute(base)
}
export function optional(base: any, execute: (value: any) => unknown) {
  return execute?.(base)
}
export function spread(base: any, execute: (value: any) => unknown) {
  return execute(...[base])
}
export function dynamicScope(base: any, execute: (value: any) => unknown) {
  void eval
  return execute(base)
}
export function argumentsAlias(base: any, execute: (value: any) => unknown) {
  void arguments
  return execute(base)
}
export function shadowed(base: any, execute: (value: any) => unknown) {
  { const base = 'SELECT 0'; void base }
  return execute(base)
}
export function deleted(base: any, execute: (value: any) => unknown) {
  delete base.text
  return execute(base)
}
export function nestedClass(base: any, execute: (value: any) => unknown) {
  const Nested = class { static value = base }
  void Nested
  return execute(base)
}
