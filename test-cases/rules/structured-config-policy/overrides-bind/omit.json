{
  "overrides": [
    {
      "files": ["**/*.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "property": "bind",
            "message": "Function.prototype.bind is banned"
          }
        ]
      }
    },
    {
      "files": ["**/*.tsx"],
      "rules": {
        "no-console": "error"
      }
    }
  ]
}
