{
  // Nested configs rebase these override globs against their own directory.
  "overrides": [
    {
      "files": [
        "**/nested/**",
        "**/lost/**",
        "**/drift/**",
        "**/superset/**",
        "**/deep/**",
        "**/string-extends/**",
        "**/empty-children/**",
        "**/multi/**",
        "**/multi-ok/**",
        "**/symlink/**",
        "**/outside/**"
      ],
      "rules": {
        "no-void": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["**/*.ts"],
      "rules": {
        "no-debugger": "off"
      }
    },
    {
      "files": ["**/other-helpers/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/nested/**"],
      "rules": {}
    },
    {
      "files": ["**/nested/**"]
    }
  ]
}
