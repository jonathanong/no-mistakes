{
  "rules": [
    {
      "rule": "postgres-required-predicates",
      "scope": "repository",
      "options": {
        "executorNames": [],
        "sqlInclude": [
          "**/*.sql"
        ],
        "relations": [
          {
            "table": "orders",
            "requireColums": [
              "account_id"
            ]
          }
        ]
      }
    }
  ]
}
