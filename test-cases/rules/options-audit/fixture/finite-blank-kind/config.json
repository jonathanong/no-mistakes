{
  "rules": [
    {
      "rule": "finite-set-consistency",
      "scope": "repository",
      "options": {
        "sets": [
          {
            "name": "a",
            "kind": "  ",
            "file": "values.yml",
            "key": "values"
          },
          {
            "name": "b",
            "kind": "yaml-string-selector",
            "file": "values.yml",
            "key": "values.[]"
          }
        ],
        "comparisons": [
          {
            "left": "a",
            "right": "b"
          }
        ]
      }
    }
  ]
}
