{
  "jsPlugins": [
    {
      "name": "no-mistakes",
      "specifier": "../../../../packages/eslint-plugin-no-mistakes/src/index.js"
    }
  ],
  "rules": {
    "no-mistakes/require-top-level-registration": [
      "error",
      {
        "registrar": {
          "source": "@app/lifecycle",
          "imported": "register"
        },
        "callback": "onStop"
      }
    ]
  }
}
