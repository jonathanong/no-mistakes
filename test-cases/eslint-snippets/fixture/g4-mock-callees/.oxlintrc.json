{
  "jsPlugins": [
    {
      "name": "no-mistakes",
      "specifier": "../../../../packages/eslint-plugin-no-mistakes/src/index.js"
    }
  ],
  "categories": { "correctness": "off" },
  "overrides": [
    { "files": ["**/boundary.ts"], "rules": { "no-mistakes/module-mock-boundary": "error" } },
    {
