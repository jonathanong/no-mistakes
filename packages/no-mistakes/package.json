{
  "name": "no-mistakes",
  "version": "0.48.0",
  "description": "Static codebase analysis tools for TS/JS dependencies, dependents, and symbols",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanong/no-mistakes.git",
    "directory": "packages/no-mistakes"
  },
  "bin": {
    "no-mistakes": "bin/no-mistakes"
  },
  "files": [
    "bin/",
    "*.d.ts",
    "index.js",
    "index.mjs",
    "planning.js",
    "workflow-topology-index.js",
    "workflow-topology-index-helpers.js",
    "scripts/install.js",
    "scripts/install/",
    "README.md",
    "LICENSE"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./planning.js": "./planning.js",
    "./workflow-topology-index.js": "./workflow-topology-index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "postinstall": "node scripts/install.js"
  }
}
