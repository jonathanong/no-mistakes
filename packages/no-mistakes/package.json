{
  "name": "no-mistakes",
  "version": "0.61.4",
  "description": "Deterministic impact maps, test plans, Playwright coverage, and repository checks for coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanong/no-mistakes.git",
    "directory": "packages/no-mistakes"
  },
  "bin": {
    "no-mistakes": "bin/no-mistakes.js"
  },
  "files": [
    "bin/",
    "*.d.ts",
    "index.js",
    "index.mjs",
    "planning-impact-artifacts.js",
    "planning-impact-artifacts-errors.js",
    "planning-impact-artifacts-files.js",
    "planning-impact-artifacts-inputs.js",
    "planning-impact-artifacts-lock.js",
    "planning-impact-artifacts-privacy.js",
    "planning-impact-cli.js",
    "planning.js",
    "workflow-topology-index.js",
    "workflow-topology-index-helpers.js",
    "scripts/native-package.js",
    "README.md",
    "LICENSE"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./planning.js": "./planning.js",
    "./workflow-topology-index.js": "./workflow-topology-index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "no-mistakes-darwin-arm64": "0.61.4",
    "no-mistakes-linux-arm64-gnu": "0.61.4",
    "no-mistakes-linux-x64-gnu": "0.61.4",
    "no-mistakes-win32-x64-msvc": "0.61.4"
  }
}
