{
  "name": "eslint-plugin-no-mistakes",
  "version": "0.101.0",
  "description": "ESLint and Oxlint rules that keep code static enough for no-mistakes analyzers and coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanong/no-mistakes.git",
    "directory": "packages/eslint-plugin-no-mistakes"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "main": "src/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": ">=8",
    "eslint": ">=9",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "//": "typescript stays on 6.0.3. TypeScript 7 makes the typescript-eslint parser throw on load. https://github.com/typescript-eslint/typescript-eslint/issues/12518 Related: https://github.com/typescript-eslint/typescript-eslint/issues/10940"
}
