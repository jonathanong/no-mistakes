  "postgres-no-nonliteral-sql-registry-key": [
    {
      "file": "app.ts",
      "findings": [
        {
          "column": 24,
          "endColumn": 43,
          "endLine": 14,
          "file": "app.ts",
          "line": 14,
          "message": "registry[key] can select an inherited property, so this lookup is not a finite SQL identifier. Return each entry from a switch with a throwing default (((key) => { switch (key) { case \"users\": return \"users\"; case \"teams\": return \"teams\"; default: throw new Error(\"unknown\"); } })((tableName))). A runtime own-key check is not judged.",
          "messageId": "dynamicKey",
          "ruleId": "no-mistakes/postgres-no-nonliteral-sql-registry-key",
          "severity": 2
        }
      ],
      "kind": "invalid",
