[
  {
    "file": "test-cases/eslint-snippets/fixture/executor-target/member-local.ts",
    "findings": [
      {
        "column": 14,
        "endColumn": 18,
        "endLine": 12,
        "file": "test-cases/eslint-snippets/fixture/executor-target/member-local.ts",
        "line": 12,
        "message": "This call passes read into a helper. Name the executor inside the helper (`read(sql`…`)`, or `const exec = read; exec(sql`…`)`) instead of passing it. Analysis does not follow an executor passed as a value, so this call is not a judged rewrite. Write the SQL as an argument of that executor. Analysis cannot check SQL that only reaches the executor through a passed function.",
        "messageId": "passed",
        "ruleId": "no-mistakes/postgres-no-executor-adapter",
        "severity": 2
      },
      {
        "column": 14,
        "endColumn": 44,
        "endLine": 18,
        "file": "test-cases/eslint-snippets/fixture/executor-target/member-local.ts",
        "line": 18,
        "message": "This callback only forwards to read. Call that executor on the SQL text (`read(sql)`, or `const exec = read; exec(sql)`). Passing the function into a helper (`methods.load(read)`) does not connect the statement to the executor, so analysis cannot see it.",
        "messageId": "forward",
        "ruleId": "no-mistakes/postgres-no-executor-adapter",
        "severity": 2
      }
    ],
    "kind": "invalid",
    "options": [
      {
        "executorTypeNames": [
          "QueryExecutor"
        ],
        "importSpecifier": "@example/db",
        "mode": "forwarding-only"
      }
    ],
    "typed": false
  },
