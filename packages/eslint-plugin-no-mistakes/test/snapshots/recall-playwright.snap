      {
        "column": 9,
        "endColumn": 15,
        "endLine": 11,
        "file": "playwright/branches.spec.js",
        "line": 11,
        "message": "`suffix` is generated once by `randomSuffix()` at module/describe scope, but `beforeAll` can re-run in the same worker process with module state preserved — the hoisted value is reused unchanged on re-entry and collides with itself. Move the `randomSuffix()` call to the first statement inside this `beforeAll` instead.",
        "messageId": "hoisted",
        "ruleId": "no-mistakes/playwright-no-hoisted-unique-token",
        "severity": 2
      },
