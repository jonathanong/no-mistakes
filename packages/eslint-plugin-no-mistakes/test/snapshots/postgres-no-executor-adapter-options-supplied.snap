        "column": 30,
        "endColumn": 35,
        "endLine": 61,
        "file": "test-cases/eslint-snippets/fixture/executor-options-supplied/controls.ts",
        "line": 61,
        "message": "This call passes query into a helper. Name the executor inside the helper (`query(sql`…`)`) instead of passing it. Analysis does not follow an executor passed as a value, so this call is not a judged rewrite. Write the SQL as an argument of that executor. Analysis cannot check SQL that only reaches the executor through a passed function.",
        "messageId": "passed",
        "ruleId": "no-mistakes/postgres-no-executor-adapter",
        "severity": 2
      },
      {
        "column": 30,
        "endColumn": 61,
        "endLine": 68,
        "file": "test-cases/eslint-snippets/fixture/executor-options-supplied/controls.ts",
        "line": 68,
        "message": "This callback only forwards to query. Call that executor on the SQL text (`query(sql)`). Passing the function into a helper (`reject(id, { query: query })`) does not connect the statement to the executor, so analysis cannot see it.",
        "messageId": "forward",
        "ruleId": "no-mistakes/postgres-no-executor-adapter",
        "severity": 2
      },
