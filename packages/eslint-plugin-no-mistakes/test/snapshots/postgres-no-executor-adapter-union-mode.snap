        "ruleId": "no-mistakes/postgres-no-executor-adapter",
        "severity": 2
      }
    ],
    "kind": "invalid",
    "options": [
      {
        "executorTypeNames": [
          "QueryExecutor"
        ],
        "importSpecifier": "@example/db",
        "mode": "forwarding-only",
        "trustedSqlTags": [
          {
            "module": "@example/sql",
            "name": "sql"
          }
        ]
      }
    ]
  }
]
