        "endLine": 62,
        "file": "test-cases/eslint-snippets/fixture/executor-target/forwarding-mode.ts",
        "line": 62,
        "message": "This adapter hides read or write from SQL analysis (conditional selection). Call the executor on the SQL text (`read(sql) or write(sql) or (flag ? read : write)(sql)`). `visibleUntyped(read) or visibleUntyped(write)` is not a judged rewrite: analysis does not follow an executor passed as a value. Write the direct call explicitly. Analysis cannot check SQL that only reaches the executor through this adapter.",
        "messageId": "blocked",
        "ruleId": "no-mistakes/postgres-no-executor-adapter",
        "severity": 2
      },
