        "column": 5,
        "endColumn": 35,
        "endLine": 11,
        "file": "test-cases/eslint-snippets/fixture/executor-target/local.ts",
        "line": 11,
        "message": "This callback only forwards to read. Call that executor on the SQL text (`read(sql)`, or `const exec = read; exec(sql)`). Passing the function into a helper (`run(read)`) does not connect the statement to the executor, so analysis cannot see it.",
        "messageId": "forward",
        "ruleId": "no-mistakes/postgres-no-executor-adapter",
        "severity": 2
      },
      {
        "column": 5,
        "endColumn": 51,
        "endLine": 17,
        "file": "test-cases/eslint-snippets/fixture/executor-target/local.ts",
        "line": 17,
        "message": "This adapter hides read from SQL analysis (conditional selection). Call the executor on the SQL text (`read(sql)`, or `const exec = read; exec(sql)`). `run(read)` is not a judged rewrite: analysis does not follow an executor passed as a value. Write the direct call explicitly. Analysis cannot check SQL that only reaches the executor through this adapter.",
        "messageId": "blocked",
        "ruleId": "no-mistakes/postgres-no-executor-adapter",
        "severity": 2
      }
    ],
    "kind": "invalid",
    "options": [
      {
        "executorTypeNames": [
          "QueryExecutor"
        ],
        "importSpecifier": "@example/db"
      }
    ]
  },
