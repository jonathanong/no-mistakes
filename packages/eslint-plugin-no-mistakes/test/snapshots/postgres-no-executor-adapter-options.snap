        "file": "test-cases/eslint-snippets/fixture/executor-target/options.ts",
        "line": 32,
        "message": "This callback only forwards to read. Call that executor on the SQL text (`read(sql)`, or `const exec = read; exec(sql)`). Passing the function into a helper (`named({ query: read })`) does not connect the statement to the executor, so analysis cannot see it.",
        "messageId": "forward",
        "ruleId": "no-mistakes/postgres-no-executor-adapter",
        "severity": 2
