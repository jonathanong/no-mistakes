#!/bin/sh

# Pre-push hook: checks only; it should not modify tracked files.

remote="$1"
remote_url="$2"

# Fetch the latest main from the actual push destination to ensure comparison is accurate.
echo "Fetching $remote main..."
if ! git fetch "$remote_url" main >/dev/null 2>&1; then
  echo "Error: Could not fetch main from push destination '$remote_url'."
  echo "Please check your network/authentication and retry."
  exit 1
fi

while read local_ref local_sha remote_ref remote_sha
do
  case "$local_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  # Skip main itself and remote branch deletions.
  if [ "$local_ref" = "refs/heads/main" ] || [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  # Check if the branch being pushed is behind the push destination's main.
  behind_count=$(git rev-list --count "$local_sha"..FETCH_HEAD)
  if [ "$behind_count" -gt 0 ]; then
    echo "Error: Branch '${local_ref#refs/heads/}' is behind $remote main by $behind_count commit(s)."
    echo "Please rebase onto the push destination's main before pushing."
    exit 1
  fi
done

if ! command -v ast-grep >/dev/null 2>&1; then
  echo "Error: ast-grep is not installed. Install it (e.g. 'brew install ast-grep') and retry."
  exit 1
fi

root=$(git rev-parse --show-toplevel)
oxfmt="$root/node_modules/.bin/oxfmt"
oxlint="$root/node_modules/.bin/oxlint"
if [ ! -x "$oxfmt" ] || [ ! -x "$oxlint" ]; then
  echo "Error: oxfmt/oxlint not found under node_modules/.bin. Run 'pnpm install' and retry."
  exit 1
fi

# cargo fmt and clippy share target/, so they stay sequential. Other checks
# are independent and run in parallel. Call oxfmt/oxlint directly to skip
# `pnpm run` lockfile + prepare overhead.

fail=0

echo "Running ast-grep..."
(
  ast-grep test --skip-snapshot-tests && ast-grep scan
) </dev/null &
pid_ast=$!

echo "Running cargo fmt + clippy..."
(
  cargo fmt --all -- --check &&
    cargo clippy --all-targets --all-features -- -D warnings
) </dev/null &
pid_rust=$!

echo "Running oxfmt check..."
"$oxfmt" --check packages/ vitest.config.js </dev/null &
pid_oxfmt=$!

echo "Running oxlint..."
"$oxlint" packages/ vitest.config.js </dev/null &
pid_oxlint=$!

wait "$pid_ast" || fail=1
wait "$pid_rust" || fail=1
wait "$pid_oxfmt" || fail=1
wait "$pid_oxlint" || fail=1

exit "$fail"
