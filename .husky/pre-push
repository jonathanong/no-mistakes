#!/bin/sh

# Pre-push hook: checks only; it should not modify tracked files.

remote="$1"
remote_url="$2"

# Fetch the latest main from the actual push destination to ensure comparison is accurate.
echo "Fetching $remote main..."
if ! git fetch "$remote_url" main >/dev/null 2>&1; then
  echo "Error: Could not fetch main from push destination '$remote_url'."
  echo "Please check your network/authentication and retry."
  exit 1
fi
base=$(git rev-parse --verify "FETCH_HEAD^{commit}") || exit 1

while read -r local_ref local_sha _
do
  case "$local_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  # Skip main itself and remote branch deletions.
  if [ "$local_ref" = "refs/heads/main" ] || [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  # Check if the branch being pushed is behind the push destination's main.
  if ! git merge-base --is-ancestor "$local_sha" "$base"; then
    behind_count=$(git rev-list --count "$local_sha..$base") || exit 1
    echo "Error: Branch '${local_ref#refs/heads/}' is behind $remote main by $behind_count commit(s)."
    echo "Please rebase onto the push destination's main before pushing."
    exit 1
  fi
done

if ! command -v ast-grep >/dev/null 2>&1; then
  echo "Error: ast-grep is not installed. Install it (e.g. 'brew install ast-grep') and retry."
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "Error: python3 is not installed."
  exit 1
fi

root=$(git rev-parse --show-toplevel)
oxfmt="$root/node_modules/.bin/oxfmt"
oxlint="$root/node_modules/.bin/oxlint"
if [ ! -x "$oxfmt" ] || [ ! -x "$oxlint" ]; then
  echo "Error: oxfmt/oxlint not found under node_modules/.bin. Run 'pnpm install' and retry."
  exit 1
fi

# Rustfmt only reads source in check mode. The fixture baseline and AST rules
# also only read source, so each can run independently.

fail=0

echo "Running ast-grep rule tests..."
ast-grep test --skip-snapshot-tests </dev/null &
pid_ast_test=$!
echo "Running ast-grep source scan..."
ast-grep scan --off=no-inline-test-fixture-write --off=no-inline-test-fixture-write-cfg </dev/null &
pid_ast_scan=$!
echo "Checking the inline fixture baseline..."
python3 .ast-grep/check-inline-fixture-writes.py --base "$base" </dev/null &
pid_fixtures=$!

echo "Running cargo fmt..."
cargo fmt --all -- --check </dev/null &
pid_fmt=$!
echo "Running Clippy..."
cargo clippy --locked --workspace --all-targets --all-features -- -D warnings </dev/null &
pid_clippy=$!

echo "Running oxfmt check..."
"$oxfmt" --check packages/ vitest.config.js </dev/null &
pid_oxfmt=$!

echo "Running oxlint..."
"$oxlint" packages/ vitest.config.js </dev/null &
pid_oxlint=$!

echo "Running CSpell..."
pnpm run lint:spell </dev/null &
pid_cspell=$!

wait "$pid_ast_test" || fail=1
wait "$pid_ast_scan" || fail=1
wait "$pid_fixtures" || fail=1
wait "$pid_fmt" || fail=1
wait "$pid_clippy" || fail=1
wait "$pid_oxfmt" || fail=1
wait "$pid_oxlint" || fail=1
wait "$pid_cspell" || fail=1

exit "$fail"
