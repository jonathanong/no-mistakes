{
  "name": "no-mistakes-monorepo",
  "version": "0.100.0",
  "private": true,
  "description": "Deterministic AST-based codebase intelligence for humans and AI agents",
  "homepage": "https://github.com/jonathanong/no-mistakes#readme",
  "bugs": {
    "url": "https://github.com/jonathanong/no-mistakes/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonathanong/no-mistakes.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:js": "pnpm --recursive --if-present run build",
    "build:native": "node packages/no-mistakes/scripts/local-stage-native.js",
    "evals": "bash scripts/run-evals.sh",
    "test": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=dot --reporter=github-actions --exclude packages/no-mistakes/test-timeout-policy/browser-route.test.mjs --exclude packages/no-mistakes/test-timeout-policy/storybook-route.test.mjs --exclude packages/no-mistakes/test-timeout-policy/review-context-options.test.mjs",
    "test:timeout-policy-browser": "vitest run --coverage=false packages/no-mistakes/test-timeout-policy/browser-route.test.mjs packages/no-mistakes/test-timeout-policy/storybook-route.test.mjs packages/no-mistakes/test-timeout-policy/review-context-options.test.mjs",
    "fmt:js": "oxfmt --write packages/ vitest.config.js",
    "fmt:js:check": "oxfmt --check packages/ vitest.config.js",
    "lint:js": "oxlint packages/ vitest.config.js",
    "lint:duplicates": "jscpd",
    "lint:spell": "cspell lint README.md \"docs/**/*.md\" \"packages/*/README.md\" cspell.config.yaml package.json --no-progress --no-gitignore --show-suggestions --no-must-find-files",
    "pack:check": "pnpm --filter './packages/*' pack --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jscpd": "5.4.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "pr-shepherd": "^1.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "packageManager": "pnpm@11.24.0"
}
