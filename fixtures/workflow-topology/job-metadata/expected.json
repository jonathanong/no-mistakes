{
  "schemaVersion": 1,
  "workflows": [
    {
      "id": ".github/workflows/default.yml",
      "path": ".github/workflows/default.yml",
      "name": "Default metadata",
      "callable": false,
      "triggers": [
        {
          "event": "push"
        }
      ],
      "jobIds": [
        ".github/workflows/default.yml#default",
        ".github/workflows/default.yml#override"
      ],
      "env": {
        "A_WORKFLOW": "${{ secrets.WORKFLOW_TOKEN }}",
        "B_UPPER_WORKFLOW": "${{ SECRETS.Upper_Token }}",
        "C_DUPLICATE_WORKFLOW": "${{ SECRETS.workflow_token }}",
        "Z_WORKFLOW": "9"
      },
      "secretReferences": [
        "Upper_Token",
        "WORKFLOW_TOKEN"
      ]
    },
    {
      "id": ".github/workflows/malformed-metadata.yml",
      "path": ".github/workflows/malformed-metadata.yml",
      "name": "Malformed metadata",
      "callable": false,
      "triggers": [
        {
          "event": "push"
        }
      ],
      "jobIds": [
        ".github/workflows/malformed-metadata.yml#malformed",
        ".github/workflows/malformed-metadata.yml#unsupported-environment"
      ],
      "env": {
        "true": "false"
      }
    },
    {
      "id": ".github/workflows/workflow-permissions.yml",
      "path": ".github/workflows/workflow-permissions.yml",
      "name": "Workflow permissions",
      "callable": false,
      "triggers": [
        {
          "event": "push"
        }
      ],
      "jobIds": [
        ".github/workflows/workflow-permissions.yml#empty",
        ".github/workflows/workflow-permissions.yml#inherited",
        ".github/workflows/workflow-permissions.yml#write-all"
      ]
    }
  ],
  "jobs": [
    {
      "id": ".github/workflows/default.yml#default",
      "workflowId": ".github/workflows/default.yml",
      "key": "default",
      "kind": "job",
      "condition": "SECRETS.BARE_JOB_TOKEN != ''",
      "steps": [
        {
          "index": 0,
          "kind": "run",
          "id": "build",
          "name": "Build",
          "run": "echo \"${{ secrets.STEP_RUN_TOKEN }}\"\n",
          "with": {
            "enabled": true,
            "retries": 3
          },
          "env": {
            "COUNT": "2",
            "STEP_ENV": "${{ secrets.STEP_ENV_TOKEN }}"
          },
          "secretReferences": [
            "STEP_ENV_TOKEN",
            "STEP_RUN_TOKEN"
          ]
        },
        {
          "index": 1,
          "kind": "action",
          "uses": "example/action@v1",
          "with": {
            "retries": 2,
            "token": "${{ secrets['ACTION_TOKEN'] }}"
          },
          "env": {},
          "secretReferences": [
            "ACTION_TOKEN"
          ]
        }
      ],
      "environment": "production",
      "timeoutMinutes": 45,
      "runsOn": "ubuntu-latest",
      "permissions": {
        "source": "default",
        "scopes": {
          "contents": "read",
          "metadata": "read",
          "packages": "read"
        },
        "assumed_default": true
      },
      "outputs": {
        "numeric": "4",
        "result": "${{ steps.build.outputs.result }}"
      },
      "env": {
        "FLAG": "true",
        "JOB_TOKEN": "${{ secrets.Job_Token }}"
      },
      "secretReferences": [
        "BARE_JOB_TOKEN",
        "Job_Token"
      ]
    },
    {
      "id": ".github/workflows/default.yml#override",
      "workflowId": ".github/workflows/default.yml",
      "key": "override",
      "kind": "job",
      "steps": [
        {
          "index": 0,
          "kind": "run",
          "run": "echo \"${{ secrets[inputs.dynamic] }} ${{ 'secrets.QUOTED' }}\""
        }
      ],
      "environment": "staging",
      "runsOn": [
        "self-hosted",
        "${{ matrix.label }}"
      ],
      "permissions": {
        "source": "job",
        "scopes": {
          "contents": "write",
          "issues": "none",
          "metadata": "read"
        },
        "assumed_default": false
      },
      "outputs": {},
      "env": {}
    },
    {
      "id": ".github/workflows/malformed-metadata.yml#malformed",
      "workflowId": ".github/workflows/malformed-metadata.yml",
      "key": "malformed",
      "kind": "job",
      "steps": [
        {
          "index": 0,
          "kind": "run",
          "run": "42"
        },
        {
          "index": 1,
          "kind": "run",
          "run": "echo metadata",
          "with": {
            "true": false
          },
          "env": {
            "true": "false"
          }
        }
      ],
      "runsOn": {
        "group": "hosted",
        "labels": "ubuntu-latest"
      },
      "permissions": {
        "source": "default",
        "scopes": {
          "contents": "read",
          "metadata": "read",
          "packages": "read"
        },
        "assumed_default": true
      },
      "env": {}
    },
    {
      "id": ".github/workflows/malformed-metadata.yml#unsupported-environment",
      "workflowId": ".github/workflows/malformed-metadata.yml",
      "key": "unsupported-environment",
      "kind": "job",
      "steps": [],
      "runsOn": {
        "group": "restricted"
      },
      "permissions": {
        "source": "default",
        "scopes": {
          "contents": "read",
          "metadata": "read",
          "packages": "read"
        },
        "assumed_default": true
      }
    },
    {
      "id": ".github/workflows/workflow-permissions.yml#empty",
      "workflowId": ".github/workflows/workflow-permissions.yml",
      "key": "empty",
      "kind": "job",
      "steps": [],
      "runsOn": "ubuntu-latest",
      "permissions": {
        "source": "job",
        "scopes": {
          "metadata": "read"
        },
        "assumed_default": false
      }
    },
    {
      "id": ".github/workflows/workflow-permissions.yml#inherited",
      "workflowId": ".github/workflows/workflow-permissions.yml",
      "key": "inherited",
      "kind": "job",
      "steps": [],
      "runsOn": "${{ matrix.runner }}",
      "permissions": {
        "source": "workflow",
        "scopes": {
          "actions": "read",
          "artifact-metadata": "read",
          "attestations": "read",
          "checks": "read",
          "code-quality": "read",
          "contents": "read",
          "deployments": "read",
          "discussions": "read",
          "issues": "read",
          "metadata": "read",
          "models": "read",
          "packages": "read",
          "pages": "read",
          "pull-requests": "read",
          "security-events": "read",
          "statuses": "read",
          "vulnerability-alerts": "read"
        },
        "assumed_default": false
      }
    },
    {
      "id": ".github/workflows/workflow-permissions.yml#write-all",
      "workflowId": ".github/workflows/workflow-permissions.yml",
      "key": "write-all",
      "kind": "job",
      "steps": [],
      "runsOn": "ubuntu-latest",
      "permissions": {
        "source": "job",
        "scopes": {
          "actions": "write",
          "artifact-metadata": "write",
          "attestations": "write",
          "checks": "write",
          "code-quality": "write",
          "contents": "write",
          "deployments": "write",
          "discussions": "write",
          "id-token": "write",
          "issues": "write",
          "metadata": "read",
          "models": "read",
          "packages": "write",
          "pages": "write",
          "pull-requests": "write",
          "security-events": "write",
          "statuses": "write",
          "vulnerability-alerts": "read"
        },
        "assumed_default": false
      }
    }
  ],
  "edges": [],
  "diagnostics": []
}
