  "functions": {
    "fn_touch": {
      "definition": "CREATE FUNCTION public.fn_touch() RETURNS trigger LANGUAGE plpgsql AS $fn$\nBEGIN\n  NEW.updated_at = now();\n  RETURN NEW; -- $$\nEND\n$fn$"
    },
    "fn_touch(col text)": {
      "definition": "CREATE FUNCTION public.fn_touch(col text) RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  RETURN NEW;\nEND\n$$"
    }
