          "onDelete": "SET NULL",
          "onUpdate": "NO ACTION",
          "validated": false
        }
      },
      "checkConstraints": {
        "accounts_active_check": { "definition": "CHECK ((is_active = true))" }
      },
      "uniqueConstraints": {
