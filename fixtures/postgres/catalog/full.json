      },
      "triggers": {
        "trigger_accounts_touch": {
          "definition": "CREATE TRIGGER trigger_accounts_touch BEFORE UPDATE OF display_name ON public.accounts FOR EACH ROW EXECUTE FUNCTION fn_touch('updated_at')"
        }
      }
    },
    "events": {
      "relationKind": "partitioned table",
