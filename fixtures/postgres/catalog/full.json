          "defaultExpression": "true",
          "ordinalPosition": 3
        },
        "created_at": {
          "dataType": "timestamp with time zone",
          "nullable": false,
          "generated": "VIRTUAL",
          "generatedExpression": "uuid_extract_timestamp(id)",
          "ordinalPosition": 4
        }
