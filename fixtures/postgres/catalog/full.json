      },
      "indexes": {
        "accounts_pkey": {
          "accessMethod": "btree",
          "unique": true,
          "primary": true,
          "constraintBacked": true,
          "valid": true,
          "ready": true,
          "keys": [{ "column": "id", "expression": "id" }],
          "predicate": null,
          "definition": "CREATE UNIQUE INDEX accounts_pkey ON accounts USING btree (id)"
        },
        "accounts_active_idx": {
          "accessMethod": "btree",
          "unique": false,
          "primary": false,
          "constraintBacked": false,
