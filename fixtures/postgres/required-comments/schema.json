{
  "formatVersion": 2, "coverage": "complete",
  "tables": {
    "orders": {
      "relationKind": "table",
      "comment": "One row per checkout; immutable after payment",
      "columns": {
        "id": { "dataType": "uuid", "nullable": false, "ordinalPosition": 1 },
        "note": {
          "dataType": "text",
          "nullable": true,
          "ordinalPosition": 2,
          "comment": "Free-form checkout note shown to support"
        },
        "secret": { "dataType": "text", "nullable": true, "ordinalPosition": 3 },
        "vendor_id": { "dataType": "uuid", "nullable": true, "ordinalPosition": 4 },
        "code": { "dataType": "text", "nullable": true, "ordinalPosition": 5, "comment": "ab" },
        "title": { "dataType": "text", "nullable": true, "ordinalPosition": 6, "comment": "   " }
      }
    },
    "events": {
      "relationKind": "partitioned table",
      "columns": {
        "payload": {
          "dataType": "jsonb",
          "nullable": false,
          "ordinalPosition": 1,
          "comment": "Event body recorded on the partitioned parent"
        }
      }
    },
    "blank_rows": {
      "relationKind": "table",
      "comment": "   \n",
      "columns": {
        "id": { "dataType": "uuid", "nullable": false, "ordinalPosition": 1, "comment": "x" }
      }
    },
    "short_rows": {
      "relationKind": "table",
      "comment": "ok"
    },
    "schema_migrations": {
      "relationKind": "table",
      "columns": {
        "version": { "dataType": "text", "nullable": false, "ordinalPosition": 1 }
      }
    }
  },
  "views": {
    "open_orders": { "definition": "select 1", "materialized": false },
    "paid_orders": { "definition": "select 1", "materialized": true },
    "titled_orders": {
      "definition": "select 1",
      "comment": "Orders that already have a title",
      "materialized": false
    },
    "tiny_view": { "definition": "select 1", "comment": "x", "materialized": false },
    "blank_view": { "definition": "select 1", "comment": "  ", "materialized": false }
  }
}
