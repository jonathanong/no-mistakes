{
  // Config objects also use their final declaration, matching JSON parsing.
  "compilerOptions": {
    "paths": { "stale-root/*": ["src/missing/*"] }
  },
  "compilerOptions": {
    "paths": { "stale-nested/*": ["src/missing/*"] },
    "paths": {
      "*": ["src/catch-all/*"],
      "feature/*/detail": ["src/total-length/*"],
      "feature/s*": ["src/longest-prefix/*"],
      "exact/*": ["src/wildcard/*"],
      "exact/value": ["src/exact.ts"],
      "tie/*": ["src/first-tie/*"],
      "tie/*/detail": ["src/second-tie/*"],
      "replacement/*": ["src/missing/*", "src/replacement/*"],
      // A repeated JSON key keeps its final value in its original order slot.
      "duplicate/*": ["src/missing/*"],
      "shadowed/*": ["src/missing/*"],
      "duplicate/*": ["src/replacement/*"]
    }
  }
}
