{"sha":"b9476931aeecc3e24f43a276bf1c6a2088bebe3b","node_id":"C_kwDOSaSRXNoAKGI5NDc2OTMxYWVlY2MzZTI0ZjQzYTI3NmJmMWM2YTIwODhiZWJlM2I","commit":{"author":{"name":"jongleberry","email":"jonathanrichardong@gmail.com","date":"2026-10-16T17:33:53Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-10-16T17:33:53Z"},"message":"fix(effects): preserve hoisted custom typed executor imports (#2087)\n\n* fix(effects): hoist custom type imports before annotation collection\n\n* style: format typed import native regression","tree":{"sha":"80a21e61065e68b69afb7ed4e5fd91cb79688f23","url":"https://api.github.com/repos/jonathanong/no-mistakes/git/trees/80a21e61065e68b69afb7ed4e5fd91cb79688f23"},"url":"https://api.github.com/repos/jonathanong/no-mistakes/git/commits/b9476931aeecc3e24f43a276bf1c6a2088bebe3b","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq0mABCRC1aQ7uu5UhlAAAjxQQAGw3k28EIOpcIAeiHlzuN11U\nJWkwQzG5FGLGWmeXf5N1L8wdxNW8BACF2dPf6V3l2x3U9u32gAd0odUtBdwSkHty\nSBGS9mDZKC9/mNTVekZzGQ+xRdAVv6giY0lnS+DdxTQR7AGwYwgLX6Q+0rYgY/xH\nZ5kemNqOzLwdg/bm+6MmZo3jU/Y8FwJQJsxsdvHg9/FPs6FjZ/GWLeTiEjG6zZN1\n0qll0jrHRxZxiI0/B1supwbQn/xKBMcSHBE3cpKKBU6j3k/zvp8li/S307HwmyYM\nxnq5TK+N2zvkwlNEnMcQPj4cmnyHAqnxzdJwZ9Iz4DO20a/Jaq/I5r4HawIcgsj9\nrbYQBjJGPrX0+pjm0a9nYbhAobVipmxi5859VAghnKkvRZCtwzxUDPwY5k6BQLP7\n3DKokT+CsLGijJzT7v0ekjeEGqZ9gedV9IiCNt5eHZ8fY3K3lyhDiFW+l/b5Nmrd\nldre3j+cB9LE1xxAogDnwNwjETdudhidyeszPBfDNBhtT9H6xDvqb005T3hDRty+\n+R6J+UZydAP7Jcr4u4UPikyoizTF7GFKe5O37uh10HZjoA2gXkPbpyR7pcLDEfMh\nc36iwsVGXI2O/Uy085uGztBiUu8zn0BL/Gz2JVdhEY+WUG+Xuu97yn86gFBIcX70\nxGv3/Y2NCTMhz/KlHmlx\n=11m7\n-----END PGP SIGNATURE-----\n","payload":"tree 80a21e61065e68b69afb7ed4e5fd91cb79688f23\nparent 5decc19aa3da394c850a593ee8089804268dcbfb\nauthor jongleberry <jonathanrichardong@gmail.com> 1792172033 -0700\ncommitter GitHub <noreply@github.com> 1792172033 -0700\n\nfix(effects): preserve hoisted custom typed executor imports (#2087)\n\n* fix(effects): hoist custom type imports before annotation collection\n\n* style: format typed import native regression","verified_at":"2026-10-16T17:33:53Z"}},"url":"https://api.github.com/repos/jonathanong/no-mistakes/commits/b9476931aeecc3e24f43a276bf1c6a2088bebe3b","html_url":"https://github.com/jonathanong/no-mistakes/commit/b9476931aeecc3e24f43a276bf1c6a2088bebe3b","comments_url":"https://api.github.com/repos/jonathanong/no-mistakes/commits/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/comments","author":{"login":"jonathanong","id":643505,"node_id":"MDQ6VXNlcjY0MzUwNQ==","avatar_url":"https://avatars.githubusercontent.com/u/643505?v=4","gravatar_id":"","url":"https://api.github.com/users/jonathanong","html_url":"https://github.com/jonathanong","followers_url":"https://api.github.com/users/jonathanong/followers","following_url":"https://api.github.com/users/jonathanong/following{/other_user}","gists_url":"https://api.github.com/users/jonathanong/gists{/gist_id}","starred_url":"https://api.github.com/users/jonathanong/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/jonathanong/subscriptions","organizations_url":"https://api.github.com/users/jonathanong/orgs","repos_url":"https://api.github.com/users/jonathanong/repos","events_url":"https://api.github.com/users/jonathanong/events{/privacy}","received_events_url":"https://api.github.com/users/jonathanong/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"web-flow","id":19864447,"node_id":"MDQ6VXNlcjE5ODY0NDQ3","avatar_url":"https://avatars.githubusercontent.com/u/19864447?v=4","gravatar_id":"","url":"https://api.github.com/users/web-flow","html_url":"https://github.com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"5decc19aa3da394c850a593ee8089804268dcbfb","url":"https://api.github.com/repos/jonathanong/no-mistakes/commits/5decc19aa3da394c850a593ee8089804268dcbfb","html_url":"https://github.com/jonathanong/no-mistakes/commit/5decc19aa3da394c850a593ee8089804268dcbfb"}],"stats":{"total":184,"additions":180,"deletions":4},"files":[{"sha":"8ec36da9957cbbb3193c37ba1201f082a52132ba","filename":".github/workflows/ci.yml","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/.github%2Fworkflows%2Fci.yml","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/.github%2Fworkflows%2Fci.yml","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/.github%2Fworkflows%2Fci.yml?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -306,6 +306,7 @@ jobs:\n           packages/no-mistakes/scripts/namespace-types-api.test.js\n           packages/no-mistakes/scripts/vitest-project-setups-api.test.js\n           packages/no-mistakes/scripts/annex-b-for-in-api.test.js\n+          packages/no-mistakes/scripts/type-import-order-api.test.js\n           packages/no-mistakes/scripts/planning-impact-cli.test.js\n           packages/no-mistakes/scripts/postgres-source-api.test.js\n           packages/no-mistakes/scripts/postgres-expression-arbiter-api.test.js"},{"sha":"1f0be102ca8cb9a6c7fae6cf78e4165e46149856","filename":"crates/no-mistakes/src/codebase/dependencies/extract_collector.rs","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Fdependencies%2Fextract_collector.rs","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Fdependencies%2Fextract_collector.rs","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Fdependencies%2Fextract_collector.rs?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -120,6 +120,7 @@ struct ImportCollector {\n     known_function_scopes: FxHashSet<String>,\n     imported_bindings: FxHashSet<String>,\n     predeclared_imported_bindings: FxHashSet<String>,\n+    hoisted_non_nullable_type_import: bool,\n     call_import_bindings: Vec<ImportedBinding>,\n     call_export_bindings: Vec<ExportedBinding>,\n     callable_aliases: Vec<CallableAliasBinding>,"},{"sha":"663bddafd7f551509acb5eea51e05c3dc03ce11b","filename":"crates/no-mistakes/src/codebase/dependencies/extract_entrypoints_predeclare.rs","status":"modified","additions":14,"deletions":3,"changes":17,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Fdependencies%2Fextract_entrypoints_predeclare.rs","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Fdependencies%2Fextract_entrypoints_predeclare.rs","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Fdependencies%2Fextract_entrypoints_predeclare.rs?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -80,16 +80,27 @@ fn predeclare_class_binding(collector: &mut ImportCollector, class: &Class<'_>)\n }\n \n fn predeclare_import_bindings(collector: &mut ImportCollector, import: &ImportDeclaration<'_>) {\n-    if import.import_kind.is_type() {\n-        return;\n-    }\n     let Some(specifiers) = &import.specifiers else {\n         return;\n     };\n+    if import.import_kind.is_type() {\n+        // Type imports are hoisted too. Retain this annotation-only shadow\n+        // without introducing a runtime import binding.\n+        for specifier in specifiers {\n+            let local = match specifier {\n+                ImportDeclarationSpecifier::ImportSpecifier(specifier) => &specifier.local,\n+                ImportDeclarationSpecifier::ImportDefaultSpecifier(specifier) => &specifier.local,\n+                ImportDeclarationSpecifier::ImportNamespaceSpecifier(specifier) => &specifier.local,\n+            };\n+            collector.hoisted_non_nullable_type_import |= local.name == \"NonNullable\";\n+        }\n+        return;\n+    }\n     for specifier in specifiers {\n         let local = match specifier {\n             ImportDeclarationSpecifier::ImportSpecifier(specifier) => {\n                 if specifier.import_kind.is_type() {\n+                    collector.hoisted_non_nullable_type_import |= specifier.local.name == \"NonNullable\";\n                     continue;\n                 }\n                 &specifier.local"},{"sha":"9f6daf9a337f74f75bb09e448b15e72025ea9945","filename":"crates/no-mistakes/src/codebase/dependencies/extract_value_flow/collect_helpers.rs","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Fdependencies%2Fextract_value_flow%2Fcollect_helpers.rs","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Fdependencies%2Fextract_value_flow%2Fcollect_helpers.rs","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Fdependencies%2Fextract_value_flow%2Fcollect_helpers.rs?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -39,6 +39,7 @@ impl ImportCollector {\n                     return ValueType::Unknown;\n                 }\n                 if name == \"NonNullable\"\n+                    && !self.hoisted_non_nullable_type_import\n                     && !self.type_binding_shadows(root)\n                     && !self.imported_bindings.contains(root)\n                     && !self.predeclared_imported_bindings.contains(root)"},{"sha":"e2a071167e44c97466f4723253bb6bf908874649","filename":"crates/no-mistakes/src/codebase/rules/query_reached_per_item/tests.rs","status":"modified","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Frules%2Fquery_reached_per_item%2Ftests.rs","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Frules%2Fquery_reached_per_item%2Ftests.rs","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Frules%2Fquery_reached_per_item%2Ftests.rs?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -496,3 +496,5 @@ mod projections;\n mod typed_clients;\n \n mod namespace_shadows;\n+#[path = \"tests/type_import_order.rs\"]\n+mod type_import_order;"},{"sha":"912421e66414713eaa35a16c4acf05d3a0e2c360","filename":"crates/no-mistakes/src/codebase/rules/query_reached_per_item/tests/type_import_order.rs","status":"added","additions":59,"deletions":0,"changes":59,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Frules%2Fquery_reached_per_item%2Ftests%2Ftype_import_order.rs","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Frules%2Fquery_reached_per_item%2Ftests%2Ftype_import_order.rs","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/crates%2Fno-mistakes%2Fsrc%2Fcodebase%2Frules%2Fquery_reached_per_item%2Ftests%2Ftype_import_order.rs?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -0,0 +1,59 @@\n+use super::*;\n+\n+#[test]\n+fn custom_type_imports_are_hoisted_before_annotation_collection() {\n+    let root = root().with_file_name(\"typed-import-order-fixture\");\n+    let findings = crate::codebase::rules::run_check(&root, None, None).unwrap();\n+    for (file, line) in [\n+        (\"early.mts\", 5),\n+        (\"late.mts\", 4),\n+        (\"mixed.mts\", 4),\n+        (\"late-shapes.mts\", 4),\n+    ] {\n+        assert!(\n+            findings\n+                .iter()\n+                .any(|finding| finding.file == file && finding.line == line),\n+            \"missing {file}:{line}: {findings:#?}\"\n+        );\n+        let report =\n+            crate::effects_query::run(&root, None, None, \"postgres\", Path::new(file), &[], None)\n+                .unwrap();\n+        assert_eq!(\n+            report\n+                .call_sites\n+                .iter()\n+                .map(|site| (site.file.as_str(), site.line))\n+                .collect::<Vec<_>>(),\n+            [(file, line)],\n+            \"{report:#?}\"\n+        );\n+    }\n+    // A custom import cannot lend its identity to another file's builtin or type parameter.\n+    assert!(\n+        !findings\n+            .iter()\n+            .any(|finding| finding.file == \"controls.mts\"),\n+        \"{findings:#?}\"\n+    );\n+}\n+\n+#[test]\n+fn hoisted_type_imports_do_not_create_runtime_import_identities() {\n+    use crate::codebase::dependencies::extract::{\n+        extract_import_facts_from_program, CallTargetIdentity,\n+    };\n+    let root = root().with_file_name(\"typed-import-order-fixture\");\n+    let source = std::fs::read_to_string(root.join(\"runtime-identity.mts\")).unwrap();\n+    let allocator = oxc_allocator::Allocator::default();\n+    let parsed = oxc_parser::Parser::new(&allocator, &source, oxc_span::SourceType::ts()).parse();\n+    assert!(parsed.diagnostics.is_empty());\n+    let facts = extract_import_facts_from_program(&parsed.program);\n+    let calls = facts\n+        .function_calls\n+        .iter()\n+        .filter(|call| call.callee == \"NonNullable\")\n+        .collect::<Vec<_>>();\n+    assert_eq!(calls.len(), 1);\n+    assert_eq!(calls[0].target_identity, CallTargetIdentity::Global);\n+}"},{"sha":"8c3a32a53973a6c926cb3581791837d151c7e706","filename":"docs/configuration/effects.md","status":"modified","additions":3,"deletions":1,"changes":4,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/docs%2Fconfiguration%2Feffects.md","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/docs%2Fconfiguration%2Feffects.md","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/docs%2Fconfiguration%2Feffects.md?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -91,7 +91,9 @@ names are inferred from a module name or a PostgreSQL convention.\n `typedExecutors` uses the same exact `{module, export, category?}` selector shape\n to select calls through a parameter whose explicit callable type comes from an\n imported type export. Named and namespace type imports, aliases, and explicit\n-type re-exports preserve that type provenance. Namespace member suffixes (for example,\n+type re-exports preserve that type provenance. Type imports are hoisted: an import\n+following its annotation has the same identity as an earlier import, including a\n+custom callable type named `NonNullable`. Namespace member suffixes (for example,\n `Namespace.Query`) survive explicit named and local type barrels, including aliases.\n Local spelling and a matching terminal type name alone do not select a call. These calls carry the transaction\n marker in `query-reached-per-item` findings."},{"sha":"36073d889bc21e00d3dd59b71468a02792790916","filename":"packages/no-mistakes/scripts/type-import-order-api.test.js","status":"added","additions":38,"deletions":0,"changes":38,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/packages%2Fno-mistakes%2Fscripts%2Ftype-import-order-api.test.js","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/packages%2Fno-mistakes%2Fscripts%2Ftype-import-order-api.test.js","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/packages%2Fno-mistakes%2Fscripts%2Ftype-import-order-api.test.js?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -0,0 +1,38 @@\n+const assert = require(\"node:assert/strict\");\n+const { join } = require(\"node:path\");\n+const test = globalThis.test || require(\"node:test\").test;\n+const compiled = process.env.NO_MISTAKES_TEST_NAPI_ADDON_PATH?.endsWith(\".node\");\n+\n+test(\"compiled async APIs preserve hoisted custom type imports\", { skip: !compiled }, async () => {\n+  const cjs = require(\"../index.js\");\n+  const esm = await import(\"../index.mjs\");\n+  const root = join(\n+    __dirname,\n+    \"../../../test-cases/rules/query-reached-per-item/typed-import-order-fixture\",\n+  );\n+  for (const [entry, line] of [\n+    [\"early.mts\", 5],\n+    [\"late.mts\", 4],\n+    [\"mixed.mts\", 4],\n+    [\"late-shapes.mts\", 4],\n+  ]) {\n+    const options = { root, kind: \"postgres\", entry };\n+    const pending = cjs.effects(options);\n+    assert.ok(pending instanceof Promise);\n+    const report = await pending;\n+    assert.deepEqual(\n+      report.callSites.map((site) => [site.file, site.line, site.callee]),\n+      [[entry, line, \"NonNullable\"]],\n+    );\n+    assert.deepEqual(await esm.effects(options), report);\n+    for (const api of [cjs, esm]) {\n+      const prepared = await api.analyzeProject({\n+        root,\n+        reports: [{ type: \"effects\", kind: \"postgres\", entry }],\n+      });\n+      assert.deepEqual(prepared.reports[0].result, report);\n+    }\n+  }\n+  const negative = await cjs.effects({ root, kind: \"postgres\", entry: \"controls.mts\" });\n+  assert.deepEqual(negative.callSites, []);\n+});"},{"sha":"daec15fb9e698a59e42aa482036ae2340dd4fa47","filename":"test-cases/rules/query-reached-per-item/typed-import-order-fixture/.no-mistakes.yml","status":"added","additions":9,"deletions":0,"changes":9,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2F.no-mistakes.yml","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2F.no-mistakes.yml","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2F.no-mistakes.yml?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -0,0 +1,9 @@\n+effects:\n+  postgres:\n+    typedExecutors:\n+      - { module: './unselected.mts', export: NonNullable }\n+rules:\n+  - rule: query-reached-per-item\n+    scope: repository\n+    options:\n+      effects: [postgres]"},{"sha":"e0b7ef0fb66e4d1166728ca7dda8fdd51774a2c7","filename":"test-cases/rules/query-reached-per-item/typed-import-order-fixture/controls.mts","status":"added","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fcontrols.mts","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fcontrols.mts","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fcontrols.mts?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -0,0 +1,8 @@\n+import type { QueryOptions } from './database.mts';\n+// The builtin wrapper selects the unconfigured database type, not the custom import.\n+export async function builtin(ids: string[], query: NonNullable<QueryOptions['query']>) {\n+  for (const id of ids) await query(id);\n+}\n+export async function generic<NonNullable>(ids: string[], query: NonNullable) {\n+  for (const id of ids) await query(id);\n+}"},{"sha":"239869540fdb7732da85e6639b1825f9912a397a","filename":"test-cases/rules/query-reached-per-item/typed-import-order-fixture/database.mts","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fdatabase.mts","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fdatabase.mts","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fdatabase.mts?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -0,0 +1,4 @@\n+export type TransactionQuery = (sql: string) => Promise<unknown>;\n+export type QueryOptions = { query?: TransactionQuery };\n+export declare function beginTransaction(): Promise<TransactionQuery>;\n+export declare function write(sql: string): Promise<unknown>;"},{"sha":"57823794da48d0abd7bf456146b7ea86755c3f04","filename":"test-cases/rules/query-reached-per-item/typed-import-order-fixture/early.mts","status":"added","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fearly.mts","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fearly.mts","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fearly.mts?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -0,0 +1,6 @@\n+import type { NonNullable } from './unselected.mts';\n+import type { QueryOptions } from './database.mts';\n+// Type imports are hoisted; source position cannot turn this into the builtin.\n+export async function forward(ids: string[], query: NonNullable<QueryOptions['query']>) {\n+  for (const id of ids) await query(id);\n+}"},{"sha":"1d7e88b5b8e4c5cfaefee150425f9614c9e68b63","filename":"test-cases/rules/query-reached-per-item/typed-import-order-fixture/late-shapes.mts","status":"added","additions":13,"deletions":0,"changes":13,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Flate-shapes.mts","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Flate-shapes.mts","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Flate-shapes.mts?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -0,0 +1,13 @@\n+import type { QueryOptions } from './database.mts';\n+type Options = { query: NonNullable<QueryOptions['query']> };\n+export async function indexed(ids: string[], query: Options['query']) {\n+  for (const id of ids) await query(id);\n+}\n+export async function context(callback: (query: NonNullable<QueryOptions['query']>) => Promise<void>) { await callback(async sql => {}); }\n+export async function contextual(ids: string[]) {\n+  await context(async query => {\n+    for (const id of ids) await query(id);\n+  });\n+}\n+// The utility import owns both nested annotations, despite its source position.\n+import type { NonNullable } from './unselected.mts';"},{"sha":"a873feec5b182b33e3a4c3613b7d0fbd95afad71","filename":"test-cases/rules/query-reached-per-item/typed-import-order-fixture/late.mts","status":"added","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Flate.mts","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Flate.mts","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Flate.mts?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -0,0 +1,6 @@\n+import type { QueryOptions } from './database.mts';\n+// Type imports are hoisted; source position cannot turn this into the builtin.\n+export async function forward(ids: string[], query: NonNullable<QueryOptions['query']>) {\n+  for (const id of ids) await query(id);\n+}\n+import type { NonNullable } from './unselected.mts';"},{"sha":"a2141511d3594fdb44979eeaef9ca0f8f27d9c43","filename":"test-cases/rules/query-reached-per-item/typed-import-order-fixture/mixed.mts","status":"added","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fmixed.mts","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fmixed.mts","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fmixed.mts?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -0,0 +1,6 @@\n+import type { QueryOptions } from './database.mts';\n+// Inline type modifiers are hoisted just like a whole type-only import.\n+export async function forward(ids: string[], query: NonNullable<QueryOptions['query']>) {\n+  for (const id of ids) await query(id);\n+}\n+import { type NonNullable } from './unselected.mts';"},{"sha":"b13b6817b5602019b26054f9416800fe0d0fd778","filename":"test-cases/rules/query-reached-per-item/typed-import-order-fixture/runtime-identity.mts","status":"added","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fruntime-identity.mts","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fruntime-identity.mts","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Fruntime-identity.mts?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -0,0 +1,4 @@\n+// This intentionally checks syntactic namespace separation, not TypeScript diagnostics.\n+// A hoisted type name cannot introduce an earlier runtime import occurrence.\n+export function runtimeOnly() { return NonNullable(\"value\"); }\n+import type { NonNullable } from './unselected.mts';"},{"sha":"0ae5f8b153302ba94d0f92cb5e4076951d376249","filename":"test-cases/rules/query-reached-per-item/typed-import-order-fixture/unselected.mts","status":"added","additions":5,"deletions":0,"changes":5,"blob_url":"https://github.com/jonathanong/no-mistakes/blob/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Funselected.mts","raw_url":"https://github.com/jonathanong/no-mistakes/raw/b9476931aeecc3e24f43a276bf1c6a2088bebe3b/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Funselected.mts","contents_url":"https://api.github.com/repos/jonathanong/no-mistakes/contents/test-cases%2Frules%2Fquery-reached-per-item%2Ftyped-import-order-fixture%2Funselected.mts?ref=b9476931aeecc3e24f43a276bf1c6a2088bebe3b","patch":"@@ -0,0 +1,5 @@\n+// The same exported spelling from another module is not a selected executor.\n+export type TransactionQuery = (sql: string) => Promise<unknown>;\n+export type QueryOptions = { query?: TransactionQuery };\n+export declare function write(sql: string): Promise<unknown>;\n+export type NonNullable<T> = (sql: string) => Promise<unknown>;"}]}