"""Source/data freeze only; never starts a measurement."""
import hashlib,json
from pathlib import Path
D=Path(__file__).resolve().parent
plan=json.loads((D/'performance-source-plan.json').read_text())
assert plan['status']=='REVIEWED'
assert not (D/'measurement-freeze.json').exists() and not (D/'measurement').exists()
paths={D/n for n in ['performance-source-plan.json','measure-once.py','analyze-once.py','seal-measurement.py','process_owner.py','actual-paired-functional-terminal-review.json']}
paths.update(Path(p) for p in plan['physical_inputs'])
paths.update(p for p in (D/'functional').iterdir() if p.is_file())
paths.update(p for p in (D/'import-only-controls').iterdir() if p.is_file())
for root in plan['artifacts'].values():
 paths.update(Path(root)/n for n in ['cli','addon.node','closed-artifacts.json'])
paths.update(Path(p) for p in ['/tmp/nm2076-prospective2087-source/source-proof.json','/tmp/nm2076-main-b947-publication/source-carry.json','/tmp/nm2076-current-head-ci-phase/actual-current-head-technical-gates.json','/tmp/nm-shared-baseline-2087-c896/main-merge-equivalence/actual-source-equivalence.json','/tmp/nm-shared-baseline-2087-c896/actual-original-selector-failure.json'])
paths.update(Path('/tmp/nm2076-current-head-ci-final')/n for n in ['run.json','checks.json','pr.json','main.json','actual-final-ci-review.json'])
paths.update(D/n for n in ['actual-measurement-ready-evidence.json','bounded-execution-plan.json'])
rows=[]
for p in sorted(paths):
 assert p.is_file() and not p.is_symlink()
 rows.append({'path':str(p),'bytes':p.stat().st_size,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()})
(D/'measurement-freeze.json').write_text(json.dumps({'plan_sha256':hashlib.sha256((D/'performance-source-plan.json').read_bytes()).hexdigest(),'files':rows},indent=2))
print(len(rows))
