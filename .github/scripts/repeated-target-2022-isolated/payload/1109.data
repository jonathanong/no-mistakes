effects:
  cache:
    targets:
      - module: "@vendor/valkey"
        export: primary.get
  direct-inline:
    targets:
      - module: "@vendor/valkey"
        export: directLive.get
      - module: "@vendor/valkey"
        export: directSaved.get
      - module: "@vendor/valkey"
        export: directOnce.get
      - module: "@vendor/valkey"
        export: directSibling.set
      - module: "@vendor/valkey"
        export: directNested.get
      - module: "@vendor/valkey"
        export: moduleLoopLive.get
      - module: "@vendor/valkey"
        export: moduleLoopSaved.get
      - module: "@vendor/valkey"
        export: localLoopSaved.get
      - module: "@vendor/valkey"
        export: localOuterSaved.get
      - module: "@vendor/valkey"
        export: factoryLoopSaved.get
  repeated-binding:
    targets:
      - module: "@vendor/valkey"
        export: repeatedLocal.get
      - module: "@vendor/valkey"
        export: beforeLoop.get
      - module: "@vendor/valkey"
        export: earlierAlias.get
      - module: "@vendor/valkey"
        export: localSibling.set
      - module: "@vendor/valkey"
        export: moduleRepeated.get
      - module: "@vendor/valkey"
        export: moduleSaved.get
      - module: "@vendor/valkey"
        export: deferredCopy.get
      - module: "@vendor/valkey"
        export: unrelatedCopy.get
      - module: "@vendor/valkey"
        export: nestedLoop.get
      - module: "@vendor/valkey"
        export: loopInitializer.get
