-- Text options consume decoded values once and preserve literal case.
EXPLAIN (FORMAT E'j\x73on') SELECT 1;
EXPLAIN (FORMAT U&'j\0073on') SELECT 2;
EXPLAIN (FORMAT $$json$$) SELECT 3;
EXPLAIN (ANALYZE, SERIALIZE E't\x65xt') SELECT 4;
EXPLAIN (ANALYZE, SERIALIZE U&'b\0069nary') SELECT 5;
EXPLAIN (ANALYZE, SERIALIZE $mode$text$mode$) SELECT 6;
EXPLAIN (ANALYZE E'tr\x75e') SELECT 7;
EXPLAIN (ANALYZE U&'tr\0075e') SELECT 8;
EXPLAIN (ANALYZE $$true$$) SELECT 9;
EXPLAIN (FORMAT E'JSON') SELECT 10;
EXPLAIN (FORMAT U&'JSON') SELECT 11;
EXPLAIN (FORMAT $$JSON$$) SELECT 12;
EXPLAIN (ANALYZE, SERIALIZE E'TEXT') SELECT 13;
EXPLAIN (ANALYZE, SERIALIZE U&'TEXT') SELECT 14;
EXPLAIN (ANALYZE, SERIALIZE $$TEXT$$) SELECT 15;
EXPLAIN (ANALYZE E'1') SELECT 16;
EXPLAIN (ANALYZE U&'1') SELECT 17;
EXPLAIN (ANALYZE $$1$$) SELECT 18;
EXPLAIN (FORMAT E'j'
  'son') SELECT 19;
