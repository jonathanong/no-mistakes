-- The first atomic child has no leading delimiter to reset INSERT markers.
CREATE FUNCTION default_sql() RETURNS int BEGIN ATOMIC INSERT INTO target VALUES (1) ON CONFLICT (id) WHERE id > 0 DO NOTHING; SELECT 1; END;
CREATE FUNCTION outer_sql() RETURNS int LANGUAGE SQL BEGIN ATOMIC CREATE FUNCTION inner_sql() RETURNS int BEGIN ATOMIC INSERT INTO target VALUES (2) ON CONFLICT (id) WHERE id > 0 DO NOTHING; SELECT 'é END;'; END; SELECT 2; END;
CREATE FUNCTION outer_foreign() RETURNS int BEGIN ATOMIC CREATE FUNCTION inner_foreign() RETURNS int LANGUAGE plpgsql BEGIN ATOMIC INSERT INTO target VALUES (3); END; SELECT 3; END;
-- Saved nested declarations exercise the bounded collector without reparsing bodies.
CREATE FUNCTION depth_0() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_1() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_2() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_3() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_4() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_5() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_6() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_7() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_8() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_9() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_10() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_11() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_12() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_13() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_14() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_15() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_16() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_17() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_18() RETURNS int BEGIN ATOMIC CREATE FUNCTION depth_19() RETURNS int BEGIN ATOMIC SELECT 4; END; END; END; END; END; END; END; END; END; END; END; END; END; END; END; END; END; END; END; END; 
SELECT 58;
EXPLAIN (ANALYZE TRUE, SERIALIZE TEXT) SELECT 1;
EXPLAIN (ANALYZE, SERIALIZE BINARY) SELECT 1;
EXPLAIN (SERIALIZE NONE) SELECT 1;
EXPLAIN (ANALYZE, SERIALIZE) SELECT 1;
EXPLAIN (ANALYZE, SERIALIZE 'text') SELECT 1;
EXPLAIN (SERIALIZE BINARY) SELECT 1;
EXPLAIN (ANALYZE, SERIALIZE foo) SELECT 1;
EXPLAIN (WAL TRUE) SELECT 1;
EXPLAIN (TIMING TRUE) SELECT 1;
EXPLAIN (WAL FALSE, TIMING FALSE) SELECT 1;
EXPLAIN (ANALYZE, WAL, TIMING TRUE) SELECT 1;
EXPLAIN (WAL foo) SELECT 1;
EXPLAIN (TIMING foo) SELECT 1;
CREATE FUNCTION invalid_first() RETURNS int BEGIN ATOMIC INSERT INTO target VALUES (,) ON CONFLICT (id) WHERE id > 0 DO NOTHING; SELECT 59; CREATE FUNCTION opaque_child() RETURNS int LANGUAGE SQL AS 'SELECT 1'; END;
SELECT 60;
