EXPLAIN INSERT INTO target (id) VALUES (1);
EXPLAIN ANALYZE INSERT INTO target (id) VALUES (2);
EXPLAIN (ANALYZE FALSE, VERBOSE TRUE) INSERT INTO target VALUES (3);
EXPLAIN (ANALYZE TRUE, FORMAT JSON) INSERT INTO target VALUES (4);
EXPLAIN (ANALYZE ON) INSERT INTO target VALUES (5);
EXPLAIN (ANALYZE OFF) INSERT INTO target VALUES (6);
EXPLAIN (ANALYZE 1) INSERT INTO target VALUES (7);
EXPLAIN (ANALYZE 0) INSERT INTO target VALUES (8);
EXPLAIN (ANALYZE) INSERT INTO target VALUES (9);
-- Strings and quoted names are data, never wrapper-option flags.
EXPLAIN SELECT 'ANALYZE; PREPARE; BEGIN ATOMIC END' AS "ANALYZE";
PREPARE "AS"(integer, text) AS INSERT INTO target SELECT $1 FROM (SELECT 'EXPLAIN ANALYZE') AS source;
CREATE FUNCTION f() RETURNS void LANGUAGE SQL
BEGIN ATOMIC
  INSERT INTO target VALUES (CASE WHEN true THEN 1 ELSE 2 END);
  SELECT 'END; BEGIN ATOMIC; EXPLAIN ANALYZE';
END;
SELECT 42;
CREATE FUNCTION opaque() RETURNS void LANGUAGE SQL AS $$INSERT INTO target VALUES (1); END;$$;
SELECT 43;
