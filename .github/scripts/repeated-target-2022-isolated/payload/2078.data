-- Deep supported parser syntax is deliberately bounded by projection safety.
EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN EXPLAIN SELECT 1;
SELECT 53;
EXPLAIN CREATE RECURSIVE VIEW bad AS SELECT 1;
SELECT 54;
CREATE FUNCTION bad_restore() RETURNS void LANGUAGE SQL BEGIN ATOMIC CREATE RECURSIVE VIEW bad AS SELECT 1; SELECT 55; END;
SELECT 56;
CREATE FUNCTION ctas_body() RETURNS void LANGUAGE SQL BEGIN ATOMIC CREATE TABLE copy AS SELECT id FROM target; END;
CREATE FUNCTION child_wrapper() RETURNS void LANGUAGE SQL BEGIN ATOMIC EXPLAIN SELECT 1; PREPARE q AS SELECT 2; END;
DO $$ BEGIN EXPLAIN (ANALYZE NULL) SELECT 1; CREATE FUNCTION hidden() RETURNS void LANGUAGE SQL AS 'SELECT 1'; END $$;
