EXPLAIN ("analyze" TRUE) SELECT 1;
EXPLAIN ("ANALYZE" TRUE) SELECT 1;
EXPLAIN ("analyse" TRUE) SELECT 1;
EXPLAIN ("verbose", "format" 'json') SELECT 1;
EXPLAIN (ANALYZE '1') INSERT INTO target VALUES (1);
EXPLAIN (ANALYZE '0') INSERT INTO target VALUES (1);
EXPLAIN (ANALYZE 'TRUE') SELECT 1;
EXPLAIN (ANALYZE 'OFF') SELECT 1;
EXPLAIN (ANALYZE "ON") SELECT 1;
EXPLAIN (ANALYZE "1") SELECT 1;
EXPLAIN ANALYSE SELECT 1;
EXPLAIN ANALYSE VERBOSE INSERT INTO target VALUES (1);
EXPLAIN "ANALYSE" SELECT 1;
DO $$ BEGIN IF true THEN EXPLAIN ANALYSE SELECT 1; END IF; END $$;
CREATE FUNCTION legacy_analyse() RETURNS void BEGIN ATOMIC EXPLAIN ANALYSE SELECT 1; END;

-- EXPLAIN and ANALYSE can also be ordinary expression/alias identifiers.
SELECT explain analyse FROM target;
SELECT "explain" analyse FROM target;
INSERT INTO target VALUES (1) RETURNING explain analyse;
