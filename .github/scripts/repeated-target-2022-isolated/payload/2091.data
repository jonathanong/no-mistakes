-- PostgreSQL validates every occurrence, then checks the final values together.
EXPLAIN (ANALYZE true, ANALYZE false) SELECT 1;
EXPLAIN (ANALYZE false, ANALYZE true) SELECT 1;
EXPLAIN (ANALYSE true, ANALYZE false) SELECT 1;
EXPLAIN (ANALYZE false, ANALYSE true) SELECT 1;
EXPLAIN (GENERIC_PLAN true, GENERIC_PLAN false, ANALYZE true) SELECT 1;
EXPLAIN (GENERIC_PLAN false, GENERIC_PLAN true, ANALYZE true) SELECT 1;
EXPLAIN (WAL true, WAL false) SELECT 1;
EXPLAIN (WAL false, WAL true) SELECT 1;
EXPLAIN (TIMING true, TIMING false) SELECT 1;
EXPLAIN (TIMING false, TIMING true) SELECT 1;
EXPLAIN (SERIALIZE text, SERIALIZE off) SELECT 1;
EXPLAIN (SERIALIZE off, SERIALIZE text) SELECT 1;
EXPLAIN (SERIALIZE binary, SERIALIZE none) SELECT 1;
EXPLAIN (ANALYZE true, SERIALIZE off, SERIALIZE binary) SELECT 1;
EXPLAIN (VERBOSE false, VERBOSE true) SELECT 1;
EXPLAIN (FORMAT json, FORMAT text) SELECT 1;
-- A later valid value must not erase an earlier invalid occurrence.
EXPLAIN (ANALYZE nope, ANALYZE false) SELECT 1;
EXPLAIN (WAL nope, WAL false) SELECT 1;
EXPLAIN (TIMING nope, TIMING false) SELECT 1;
EXPLAIN (SERIALIZE nope, SERIALIZE off) SELECT 1;
EXPLAIN (FORMAT nope, FORMAT json) SELECT 1;
EXPLAIN (VERBOSE nope, VERBOSE false) SELECT 1;
EXPLAIN ("ANALYZE" true, ANALYZE false) SELECT 1;
EXPLAIN (ANALYZE true, "analyze" false) SELECT 1;
EXPLAIN (ANALYZE false, ANALYZE true, ANALYZE false, GENERIC_PLAN true, GENERIC_PLAN false, WAL true, WAL false, TIMING true, TIMING false, SERIALIZE binary, SERIALIZE off) SELECT 1;
DO $$ BEGIN IF true THEN
  EXPLAIN (ANALYSE true, ANALYZE false, WAL true, WAL false) SELECT 1;
END IF; END $$;
CREATE FUNCTION repeated_options() RETURNS int BEGIN ATOMIC
  EXPLAIN (ANALYZE false, ANALYZE true, TIMING false, TIMING true) SELECT 1;
END;
SELECT 98;
