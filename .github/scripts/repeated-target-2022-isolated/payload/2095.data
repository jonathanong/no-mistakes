-- A transaction BEGIN is not a nested SQL-standard atomic body.
CREATE FUNCTION transaction_body() RETURNS void LANGUAGE SQL BEGIN ATOMIC BEGIN; END;
SELECT 81;
CREATE FUNCTION nested_case() RETURNS int LANGUAGE SQL BEGIN ATOMIC SELECT CASE 1 WHEN 1 THEN 1 ELSE 0 END; END;
SELECT 82;
