-- Quoted SQL names preserve identifier case; only lower-case sql is built in.
CREATE FUNCTION quoted_sql() RETURNS int LANGUAGE "sql" BEGIN ATOMIC SELECT 1; END;
CREATE FUNCTION quoted_upper() RETURNS int LANGUAGE "SQL" BEGIN ATOMIC SELECT 2; END;
CREATE FUNCTION conflicting() RETURNS int LANGUAGE SQL AS 'SELECT 1' BEGIN ATOMIC SELECT 3; END;
SELECT 61;
CREATE FUNCTION nested_conflicting() RETURNS int BEGIN ATOMIC CREATE FUNCTION bad_child() RETURNS int LANGUAGE SQL AS 'SELECT 1' BEGIN ATOMIC SELECT 4; END; SELECT 5; END;
EXPLAIN (FORMAT TEXT) SELECT 1;
EXPLAIN (FORMAT JSON) SELECT 1;
EXPLAIN FORMAT TEXT SELECT 1;
EXPLAIN VERBOSE FORMAT JSON SELECT 1;
DO $$ BEGIN
  IF true THEN
    EXPLAIN SELECT 'é ANALYZE';
    IF false THEN
      PREPARE branch_plan AS INSERT INTO target VALUES (1);
    ELSE
      EXPLAIN (ANALYZE FALSE) SELECT 2;
    END IF;
  ELSE
    EXPLAIN ANALYZE INSERT INTO target VALUES (2);
  END IF;
END $$;
DO $$ BEGIN IF true THEN EXPLAIN (ANALYZE NULL) SELECT 1; ELSE PREPARE good AS SELECT 2; END IF; END $$;
-- Recovery retains an incomplete declaration even when conflicting END is absent.
CREATE FUNCTION unfinished_conflict() RETURNS int LANGUAGE SQL AS 'SELECT 1' BEGIN ATOMIC SELECT 6;
